// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Exercise {
  id String @id @default(uuid())
  name String
  muscleGroup String @map("muscle_group")
  type          String   @default("strength")
  // Dono do exercício próprio (E1); nulo = catálogo.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  workoutItems WorkoutItem[]
  setLogs      SetLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("exercises")
}

enum FoodState {
  RAW
  COOKED
}

enum FoodTag {
  GLUTEN_FREE
  LACTOSE_FREE
  VEGAN
  VEGETARIAN
}

// Alimento (A1): userId nulo = catálogo; preenchido = próprio e privado. Valores por 100 g.
// O CHECK da soma (A3) está só na migration: o Prisma não modela CHECK.
model Food {
  id String @id @default(uuid())
  userId String? @map("user_id")
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  name String @db.VarChar(100)
  state FoodState
  kcal Decimal @db.Decimal(4, 1)
  proteinG Decimal @map("protein_g") @db.Decimal(4, 1)
  carbsG Decimal @map("carbs_g") @db.Decimal(4, 1)
  fatG Decimal @map("fat_g") @db.Decimal(4, 1)
  fiberG Decimal? @map("fiber_g") @db.Decimal(4, 1)
  tags FoodTag[] @default([])
  rawYields    FoodYield[] @relation("RawFood")
  cookedYields FoodYield[] @relation("CookedFood")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("foods")
}

// Rendimento (A7): fator = peso pronto ÷ peso cru, próprio e privado do usuário.
model FoodYield {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  rawFoodId String @map("raw_food_id")
  rawFood Food @relation("RawFood", fields: [rawFoodId], references: [id], onDelete: Restrict)
  cookedFoodId String @map("cooked_food_id")
  cookedFood Food @relation("CookedFood", fields: [cookedFoodId], references: [id], onDelete: Restrict)
  factor Decimal @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, rawFoodId, cookedFoodId])
  @@index([rawFoodId])
  @@index([cookedFoodId])
  @@map("food_yields")
}

enum Sex {
  F
  M
}

model User {
  id String @id @default(uuid())
  name String @db.VarChar(100)
  email String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  sex Sex?
  birthDate DateTime? @db.Date @map("birth_date")
  heightCm Int? @map("height_cm")
  timezone String @default("America/Sao_Paulo") @db.VarChar(64)
  deactivatedAt DateTime? @map("deactivated_at")

  workouts        Workout[]
  workoutSessions WorkoutSession[]
  exercises       Exercise[]
  programs        Program[]
  foods           Food[]
  foodYields      FoodYield[]
  dietPlans       DietPlan[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// Treino (antes "ficha", ADR 0014): um conjunto de itens que o usuário executa numa sessão.
model Workout {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  name String @db.VarChar(100)
  description String? @db.VarChar(255)

  items WorkoutItem[]
  workoutSessions WorkoutSession[]
  programDays ProgramDay[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workouts")
}

model WorkoutItem {
  id String @id @default(uuid())
  workoutId String @map("workout_id")
  workout Workout @relation(fields: [workoutId], references:[id], onDelete:Cascade)
  exerciseId String @map("exercise_id")
  exercise Exercise @relation(fields: [exerciseId], references:[id], onDelete:Restrict)
  order Int
  targetSets Int @map("target_sets")
  setType SetType @default(NORMAL) @map("set_type")
  targetRepsMin Int? @map("target_reps_min")
  targetRepsMax Int? @map("target_reps_max")
  targetDurationSeconds Int? @map("target_duration_seconds")
  perSide Boolean @default(false) @map("per_side")
  restSeconds Int? @map("rest_seconds")
  supersetGroup Int? @map("superset_group")
  rir Int?
  rpe Decimal? @db.Decimal(3, 1)
  progressionType ProgressionType @default(NONE) @map("progression_type")
  progressionStepPercent Decimal? @db.Decimal(3, 1) @map("progression_step_percent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workout_items")
}

enum ProgressionType {
  NONE
  DOUBLE
  LINEAR
}

enum SetType {
  NORMAL
  WARMUP
  FAILURE
  DROP
}

enum CycleType {
  WEEKLY
  ROTATING
}

// Programa: organiza os treinos num ciclo semanal (com alternância por semana) ou rotativo de N dias.
// Um ativo por usuário (garantido no service, tarefa 7).
model Program {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  name String @db.VarChar(100)
  cycleType CycleType @map("cycle_type")
  cycleDays Int @map("cycle_days")
  weeks Int @default(1)
  startDate DateTime @db.Date @map("start_date")
  active Boolean @default(false)

  days ProgramDay[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("programs")
}

// Dia do programa: semana (1..weeks), dia (1..7 ou 1..N) e treino. Dia sem linha = sem treino.
model ProgramDay {
  id String @id @default(uuid())
  programId String @map("program_id")
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  week Int
  day Int
  workoutId String @map("workout_id")
  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  order Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("program_days")
}

model WorkoutSession {
  id String @id @default(uuid())
  userId String @map("user_id")
  workoutId String @map("workout_id")
  startedAt DateTime @map("started_at")
  finishedAt DateTime? @map("finished_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  workout Workout @relation(fields: [workoutId], references:[id], onDelete: Restrict)

  setLogs SetLog[]

  @@map("workout_sessions")
}

model SetLog{
    id String @id @default(uuid())
    sessionId String @map("session_id")
    exerciseId String @map("exercise_id")
    setNumber Int @map("set_number")
    weightKg Decimal? @db.Decimal(6,2) @map("weight_kg")
    repsCompleted Int? @map("reps_completed")
    durationSeconds Int? @map("duration_seconds")
    failed  Boolean @default(false)
    workoutSession WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
    exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, exerciseId, setNumber])
  @@map("set_logs")
}
// Plano de dieta (tarefa 11a). Um ativo por usuário, garantido no service.
model DietPlan {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  name String @db.VarChar(100)
  active Boolean @default(false)

  mealSlots MealSlot[]
  dayTypes  DayType[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("diet_plans")
}

model MealSlot {
  id String @id @default(uuid())
  dietPlanId String @map("diet_plan_id")
  dietPlan DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  name String @db.VarChar(100)
  order Int

  targets MealTarget[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("meal_slots")
}

// Tipo de dia: guarda a meta do dia; trainingDay/restDay dizem qual vale com e sem treino.
model DayType {
  id String @id @default(uuid())
  dietPlanId String @map("diet_plan_id")
  dietPlan DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  name String @db.VarChar(100)
  order Int
  trainingDay Boolean @default(false) @map("training_day")
  restDay Boolean @default(false) @map("rest_day")
  kcal Decimal? @db.Decimal(6, 1)
  proteinG Decimal? @map("protein_g") @db.Decimal(6, 1)
  carbsG Decimal? @map("carbs_g") @db.Decimal(6, 1)
  fatG Decimal? @map("fat_g") @db.Decimal(6, 1)
  fiberG Decimal? @map("fiber_g") @db.Decimal(6, 1)

  mealTargets MealTarget[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("day_types")
}

model MealTarget {
  id String @id @default(uuid())
  dayTypeId String @map("day_type_id")
  dayType DayType @relation(fields: [dayTypeId], references: [id], onDelete: Cascade)
  mealSlotId String @map("meal_slot_id")
  mealSlot MealSlot @relation(fields: [mealSlotId], references: [id], onDelete: Cascade)
  kcal Decimal? @db.Decimal(6, 1)
  proteinG Decimal? @map("protein_g") @db.Decimal(6, 1)
  carbsG Decimal? @map("carbs_g") @db.Decimal(6, 1)
  fatG Decimal? @map("fat_g") @db.Decimal(6, 1)
  fiberG Decimal? @map("fiber_g") @db.Decimal(6, 1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dayTypeId, mealSlotId])
  @@map("meal_targets")
}
