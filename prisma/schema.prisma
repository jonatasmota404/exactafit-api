// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Exercise {
  id String @id @default(uuid())
  name String
  muscleGroup String @map("muscle_group")
  type          String   @default("strength")

  routineItems RoutineItem[]
  setLogs      SetLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("exercises")
}

model User {
  id String @id @default(uuid())
  name String @db.VarChar(100)
  email String @unique @db.VarChar(255)
  password String @db.VarChar(255)

  workoutRoutines WorkoutRoutine[]
  workoutSessions WorkoutSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model WorkoutRoutine {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(100)
  description String? @db.VarChar(255)

  routineItems RoutineItem[]
  workoutSessions WorkoutSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workout_routines")
}

model RoutineItem {
  id String @id @default(uuid())
  routineId String @map("routine_id")
  workoutRoutine WorkoutRoutine @relation(fields: [routineId], references:[id], onDelete:Cascade)
  exerciseId String @map("exercise_id")
  exercices Exercise @relation(fields: [exerciseId], references:[id], onDelete:Cascade)
  order Int
  targetSets Int @map("target_sets")
  targetReps Int @map("target_reps")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("routine_items")
}

model WorkoutSession {
  id String @id @default(uuid())
  userId String @map("user_id")
  routineId String @map("routine_id")
  startedAt DateTime @default(now()) @map("started_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutRoutine WorkoutRoutine @relation(fields: [routineId], references:[id], onDelete:Cascade)

  setLogs SetLog[]

  @@map("workout_sessions")
}

model SetLog{
    id String @id @default(uuid())
    sessionId String @map("session_id")
    exerciseId String @map("exercise_id")
    setNumber Int @map("set_number")
    weightKg Float @map("weight_kg")
    repsCompleted Int @map("reps_completed")
    failed  Boolean @default(false)
    workoutSession WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

  @@map("set_logs")
}