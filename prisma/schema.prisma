// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Exercise {
  id String @id @default(uuid())
  name String
  muscleGroup String @map("muscle_group")
  type          String   @default("strength")
  // Dono do exercício próprio (E1); nulo = catálogo.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  workoutItems WorkoutItem[]
  setLogs      SetLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("exercises")
}

model User {
  id String @id @default(uuid())
  name String @db.VarChar(100)
  email String @unique @db.VarChar(255)
  password String @db.VarChar(255)

  workouts        Workout[]
  workoutSessions WorkoutSession[]
  exercises       Exercise[]
  programs        Program[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// Treino (antes "ficha", ADR 0014): um conjunto de itens que o usuário executa numa sessão.
model Workout {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  name String @db.VarChar(100)
  description String? @db.VarChar(255)

  items WorkoutItem[]
  workoutSessions WorkoutSession[]
  programDays ProgramDay[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workouts")
}

model WorkoutItem {
  id String @id @default(uuid())
  workoutId String @map("workout_id")
  workout Workout @relation(fields: [workoutId], references:[id], onDelete:Cascade)
  exerciseId String @map("exercise_id")
  exercise Exercise @relation(fields: [exerciseId], references:[id], onDelete:Restrict)
  order Int
  targetSets Int @map("target_sets")
  targetReps Int @map("target_reps")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workout_items")
}

enum CycleType {
  WEEKLY
  ROTATING
}

// Programa: organiza os treinos num ciclo semanal (com alternância por semana) ou rotativo de N dias.
// Um ativo por usuário (garantido no service, tarefa 7).
model Program {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  name String @db.VarChar(100)
  cycleType CycleType @map("cycle_type")
  cycleDays Int @map("cycle_days")
  weeks Int @default(1)
  startDate DateTime @db.Date @map("start_date")
  active Boolean @default(false)

  days ProgramDay[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("programs")
}

// Dia do programa: semana (1..weeks), dia (1..7 ou 1..N) e treino. Dia sem linha = sem treino.
model ProgramDay {
  id String @id @default(uuid())
  programId String @map("program_id")
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  week Int
  day Int
  workoutId String @map("workout_id")
  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  order Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("program_days")
}

model WorkoutSession {
  id String @id @default(uuid())
  userId String @map("user_id")
  workoutId String @map("workout_id")
  startedAt DateTime @map("started_at")
  finishedAt DateTime? @map("finished_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  workout Workout @relation(fields: [workoutId], references:[id], onDelete: Restrict)

  setLogs SetLog[]

  @@map("workout_sessions")
}

model SetLog{
    id String @id @default(uuid())
    sessionId String @map("session_id")
    exerciseId String @map("exercise_id")
    setNumber Int @map("set_number")
    weightKg Decimal? @db.Decimal(6,2) @map("weight_kg")
    repsCompleted Int? @map("reps_completed")
    durationSeconds Int? @map("duration_seconds")
    failed  Boolean @default(false)
    workoutSession WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
    exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, exerciseId, setNumber])
  @@map("set_logs")
}